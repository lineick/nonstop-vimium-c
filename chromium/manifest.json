{
  "manifest_version": 3,
  "name": "Nonstop Vimium C (Chromium preview)",
  "version": "0.1.0",
  "description": "Use Vimium C in the PDF viewer. Experimental Chromium support.",
  "minimum_chrome_version": "151",
  "mime_types_handler": {
    "application/pdf": {
      "handler_url": "pdf/viewer-page.html"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  }
}
